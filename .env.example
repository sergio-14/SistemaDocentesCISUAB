# ============================================================
# Copiar a .env y completar:   cp .env.example .env
# El archivo .env está excluido de Git: nunca subirlo.
# Nombres de variables según la guía IIISyP (DJANGO_*, POSTGRES_*).
# Generar secretos solo con caracteres seguros (sin $ ni #):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ============================================================

# ------------------------------------------------------------
# Django
# ------------------------------------------------------------
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Desarrollo: True. Producción: docker-compose.prod.yml fuerza False.
DJANGO_DEBUG=True

# Admin de Django (/django-admin/). Si no se define, sigue a DJANGO_DEBUG: activo en
# desarrollo y apagado en producción (docker-compose.prod.yml usa False por defecto).
# DJANGO_ADMIN_ENABLED=True

# Desarrollo: localhost,127.0.0.1,backend
# Producción: el dominio del sistema, ej. midominio.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Orígenes HTTPS desde los que se envían formularios con sesión (admin de Django).
# Obligatorio en producción: https://midominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Solo desarrollo: Vite (5173) llama al backend (8000).
# En producción frontend y API comparten dominio y no hace falta.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# PostgreSQL 16
# ------------------------------------------------------------
POSTGRES_DB=sistema_docentes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-esta-contrasena
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
# URL pública del sistema, SIN /api al final.
# Desarrollo: http://localhost:8000   Producción: https://midominio.com
# En producción se incrusta al compilar: si cambia, hay que reconstruir el frontend.
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------
# Opcionales
# ------------------------------------------------------------
# Solo para instalaciones anteriores: las fotos y logos ahora se guardan como
# archivos en media/, pero las versiones previas los guardaban cifrados en la
# BD. Esta clave (o DJANGO_SECRET_KEY si se deja vacía) sirve para leerlos y
# pasarlos a media con "python manage.py organizar_media". Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_IMAGE_ENCRYPTION_KEY=

# Vigencia en segundos de los enlaces firmados a archivos subidos (1 h por defecto).
# Cada respuesta de la API y cada recarga de la página generan enlaces nuevos.
MEDIA_URL_MAX_AGE=3600

# HSTS: 0 = apagado. Activarlo desde Dokploy solo después de:
#   1. Verificar que https://midominio.com carga con certificado válido.
#   2. Verificar que http://midominio.com redirige a https:// (dominio en Dokploy).
# Luego, por ejemplo, SECURE_HSTS_SECONDS=3600 para probar y 31536000 (1 año) después.
# Una vez activo, los navegadores exigen HTTPS durante ese tiempo: no se deshace al instante.
SECURE_HSTS_SECONDS=0

# Backups automáticos (servicio "backup" de docker-compose.prod.yml)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
BACKUP_FIRST_DELAY_MINUTES=10
# Contraseña con la que se CIFRAN los backups (GPG, AES-256). Obligatoria en producción.
# Larga y aleatoria:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Guardarla FUERA del servidor (gestor de contraseñas): sin ella los backups no se abren.
BACKUP_PASSPHRASE=

# gunicorn (producción)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
