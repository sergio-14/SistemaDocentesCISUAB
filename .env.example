# ============================================================
# Copiar a .env y completar:   cp .env.example .env
# El archivo .env está excluido de Git: nunca subirlo.
# ============================================================

# ------------------------------------------------------------
# Django
# ------------------------------------------------------------
# Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Desarrollo: True. Producción: docker-compose.prod.yml fuerza DEBUG=False.
DJANGO_DEBUG=True

# Desarrollo: localhost,127.0.0.1,backend
# Producción: dominio del backend, ej. api.midominio.com
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Orígenes del frontend autorizados a llamar a la API (con esquema, sin barra final).
# Producción: https://midominio.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Orígenes HTTPS desde los que se envían formularios con sesión (panel /admin/).
# Obligatorio en producción: https://midominio.com,https://api.midominio.com
CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------
# Base de datos (PostgreSQL)
# ------------------------------------------------------------
DB_NAME=sistema_docentes
DB_USER=postgres
# Producción: contraseña larga y aleatoria (puede contener cualquier carácter).
DB_PASSWORD=cambiar-esta-contrasena
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
# URL pública del backend, SIN /api al final.
# Desarrollo: http://localhost:8000   Producción: https://api.midominio.com
# En producción se incrusta al compilar: si cambia, hay que reconstruir el frontend.
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------
# Opcionales
# ------------------------------------------------------------
# Clave Fernet para cifrar fotos de perfil y logos de carrera. Si se deja vacía
# se deriva de SECRET_KEY (entonces cambiar SECRET_KEY haría ilegibles las
# imágenes). Recomendado definirla en producción. Las imágenes ya cifradas con
# la clave derivada de SECRET_KEY se siguen leyendo. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_IMAGE_ENCRYPTION_KEY=

# Vigencia en segundos de los enlaces firmados a archivos subidos (12 h por defecto).
MEDIA_URL_MAX_AGE=43200

# HSTS: activar (ej. 31536000) solo cuando HTTPS funcione de forma estable.
SECURE_HSTS_SECONDS=0

# gunicorn (producción)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
