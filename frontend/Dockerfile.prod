# Imagen de producción: compila la SPA con Vite y la sirve con nginx.
# El Dockerfile normal (servidor de desarrollo de Vite) queda solo para desarrollo.

FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Vite incrusta VITE_API_URL en el build: debe ser la URL pública del backend
# (ej. https://api.midominio.com). Sin ella el frontend apuntaría a 127.0.0.1.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN test -n "$VITE_API_URL" || (echo "ERROR: falta el build arg VITE_API_URL" >&2 && exit 1)
RUN npm run build


FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
